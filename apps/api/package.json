{
  "name": "api",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && bun build src/index.ts --outdir ./dist --target bun --minify",
    "start": "bun run dist/index.js",
    "dev": "bun run --hot src/index.ts",
    "check-types": "tsc",
    "auth:generate": "bun x auth@latest generate --config ./src/auth/config.ts -y --output ../../packages/db/src/schema/auth.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.1",
    "@hono/structured-logger": "^1.0.0",
    "@hono/zod-validator": "^0.9.0",
    "@repo/db": "workspace:*",
    "@repo/core": "workspace:*",
    "better-auth": "^1.7.1",
    "hono": "^4.12.14",
    "http-status-codes": "^2.3.0",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "pino-pretty": "^13.1.3"
  }
}
